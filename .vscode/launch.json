{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost:4201",
      "url": "http://localhost:4201",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true,
      "preLaunchTask": "Start ng serve on 4201",
      "runtimeArgs": [
        "--remote-debugging-port=9222"
      ]
    }
  ]
}
